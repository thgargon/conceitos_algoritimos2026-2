programa
{
	
	funcao inicio()
	{
		real graus_celsius, fahrenheit
		escreva ("Digite a temperatura em graus_celsius: ")
		leia (graus_celsius)
		fahrenheit = ((graus_celsius*9)/5)+32
		escreva ("A temperatura em Celsius e: ", fahrenheit)
		
	}
}

programa
{
	// Leia um numero inteiro e verifique se ele é par ou impar
	funcao inicio()
	{
		inteiro n 

		escreva ("Digite um numero: ")
		leia (n)

		se(n%2==0){
			escreva ("PAR")
		}senao{
			escreva ("IMPAR")
		}

		
	}
}

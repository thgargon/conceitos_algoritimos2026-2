programa
{
	//Leia a idade de uma pessoa e informe:
	// menor de idade
	// maior de idade
	funcao inicio()
	
	{
	   inteiro n
	    escreva ("Digite sua idade: ")
	    leia (n)

	    se (n<18){
	     escreva ("menor de idade") 
	    
	    }senao {
	     	escreva ("maior de idade")
	     }

		
	
	
		
		
	}
}

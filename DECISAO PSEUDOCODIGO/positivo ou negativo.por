programa
{
	//Leia um numero inteiro e mostre se ele é positivo ou negativo
	funcao inicio()
	{
		inteiro n 

		escreva ("Digite um numero: ")
		leia (n)

		se (n<0) {
			escreva ("negativo")
		} senao se (n>0){
			escreva ("positivo")
		} senao {
			escreva ("ZERO")
		}
		
	}
}

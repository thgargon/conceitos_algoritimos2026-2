programa
{
	
	funcao inicio()
	
	{inteiro identidade, codigoFuncionario, idade
	cadeia tipoSanguineo

	escreva ("Digite seu Codigo de Funcionário: ")
	 leia (codigoFuncionario)
	 escreva ("Qual sua idade? ")
	 leia (idade)
	 escreva ("Qual seu tipo sanguineo? ")
	 leia (tipoSanguineo)
	 escreva ("Digite o numero da sua Identidade: ")
	 leia (identidade)

	 escreva ("CARTEIRA DE IDENTIFICAÇÃO DE FUNCIONÁRIO")

		escreva ("\nCÓDIGO: ", codigoFuncionario)
		escreva ("\nIDADE: " , idade)
		escreva ("\nTIPO S: ", tipoSanguineo)
		escreva ("\nID: ", identidade)
	}
}
